# Copie ce fichier en .env.local et remplis les valeurs (ne partage jamais .env.local).

# --- Cloudflare Workers AI ---
# ID du compte : tableau de bord Cloudflare > Workers AI > "Use REST API"
CLOUDFLARE_ACCOUNT_ID=
# Jeton API avec la permission "Workers AI" (Read + Edit)
CLOUDFLARE_API_TOKEN=
# Modèle utilisé (DeepSeek V4.1 Flash par défaut)
AI_MODEL=@cf/deepseek-ai/deepseek-v4.1-flash-1017
# Niveau de réflexion du modèle : none, low (rapide, par défaut), high, max
AI_REASONING_EFFORT=low

# --- Agent ---
# Numéros autorisés pour les tests, au format international sans + (séparés par des virgules).
# L'agent ne répond QU'À ces numéros, sauf si AGENT_REPLY_ALL=true.
AGENT_ALLOWED_NUMBERS=
AGENT_REPLY_ALL=false
# Mettre false pour couper complètement les réponses automatiques
AGENT_ENABLED=true
# Nombre maximum de réponses envoyées par heure (tous contacts confondus)
AGENT_MAX_REPLIES_PER_HOUR=30
# Instructions de l'agent (laisser vide pour le texte par défaut)
AGENT_SYSTEM_PROMPT=
